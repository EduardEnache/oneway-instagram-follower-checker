# Never commit personal Instagram exports
*.zip
_extract/
public/src/fixtures/private/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (only used for throwaway dev scripts; no runtime dependency)
node_modules/

# Secrets and deployment-specific config for the temporary public demo.
# TUNNEL_TOKEN is a real secret (grants tunnel control). The Sentry DSN and
# CF beacon token in public-extras/config.js are NOT secrets (they ship to
# every browser) but are deployment-specific, so they stay out of the repo.
.env
.env.*
!.env.example
public-extras/config.js
public-extras/sentry.min.js

# Cloudflare Pages build output (assembled by build-pages.sh).
/dist/
# Pages Functions staged at repo root for `wrangler pages deploy` (source is pages/functions/).
/functions/
# wrangler local cache/state.
/.wrangler/

# graphify code-graph output (regenerated on demand; folded into the homelab
# knowledge graph by ~/services/graphify-dashboard/refresh-graph.sh, read from disk).
/graphify-out/
