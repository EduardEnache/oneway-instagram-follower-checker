# Copy to .env and edit if the defaults don't suit you: `cp .env.example .env`

# Host port the app is published on. Browse http://127.0.0.1:<port>.
ONEWAY_PORT=8477

# Host interface to bind. 127.0.0.1 = loopback only (use with `tailscale serve`).
# Set to 0.0.0.0 to reach the container directly on the machine's tailnet IP.
ONEWAY_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# PUBLIC VARIANT ONLY (docker-compose.public.yml). Leave unset for the
# default, tailnet-only deployment.
# ---------------------------------------------------------------------------

# Cloudflare Zero Trust tunnel token. Zero Trust -> Networks -> Tunnels ->
# <your tunnel> -> Configure -> the string after `--token`. THIS IS A SECRET:
# it grants control of the tunnel. Never commit it.
# TUNNEL_TOKEN=eyJhIjoi...
