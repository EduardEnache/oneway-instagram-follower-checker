# Copy to .env and edit if the defaults don't suit you: `cp .env.example .env`

# Host port the app is published on. Browse http://127.0.0.1:<port>.
ONEWAY_PORT=8477

# Host interface to bind. 127.0.0.1 = loopback only (use with `tailscale serve`).
# Set to 0.0.0.0 to reach the container directly on the machine's tailnet IP.
ONEWAY_BIND=127.0.0.1
